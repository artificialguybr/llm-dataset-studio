{
  "mcpServers": {
    "llm-dataset-studio": {
      "command": "uv",
      "args": [
        "--directory",
        "/absolute/path/to/llm-dataset-studio",
        "run",
        "python",
        "-m",
        "backend.mcp_server"
      ],
      "env": {
        "IDS_API_URL": "http://127.0.0.1:8766"
      }
    }
  }
}
