# Copy to .env (backend reads from cwd) — everything optional; without keys, paid
# providers stay honestly 'unavailable'
IDS_DATA_DIR=./data
IDS_DB_URL=sqlite:///./data/studio.db

# Providers — active per capability (empty = first registered)
IDS_EMBEDDINGS_PROVIDER=
IDS_PREANNOTATION_PROVIDER=
IDS_CAPTIONING_PROVIDER=
IDS_PII_PROVIDER=
IDS_LABEL_ISSUES_PROVIDER=

# OpenAI-compatible text API (works with OpenAI, Ollama and vLLM base URLs).
# Used for pre-annotation, text generation (SFT/completions) and PII scanning.
IDS_OPENAI_API_KEY=
IDS_OPENAI_BASE_URL=https://api.openai.com/v1
IDS_OPENAI_TEXT_MODEL=gpt-4o-mini

# Device for local embedding models (cpu or cuda)
IDS_EMBEDDINGS_DEVICE=cpu
